{
  "name": "snapnote",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:headless": "xvfb-run -a tauri dev",
    "ports:clean": "lsof -i :1420 -t | xargs -r kill -9 && lsof -i :1421 -t | xargs -r kill -9",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" package.json postcss.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" package.json postcss.config.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^0.576.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
